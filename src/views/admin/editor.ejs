<%- include('../partials/header', { title, description: 'Write and edit Inkwell stories.' }) %>
<section class="editor-page"><a class="back-link" href="/admin">← All stories</a><div class="editor-heading"><div class="eyebrow"><span class="eyebrow-line"></span> THE WRITING DESK</div><h1><%= post.title ? 'Make it just right.' : 'A new story.' %></h1><p>A clear title, a small introduction, then whatever you have to say.</p></div><% if (errors && errors.length) { %><div class="form-errors" role="alert"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %><form class="editor-form" action="<%= post._id ? '/admin/posts/' + post._id : '/admin/posts' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input type="text" name="title" required minlength="3" maxlength="160" placeholder="Give the story a name" value="<%= post.title || '' %>"></label><label>Short introduction <span class="label-hint">Up to 300 characters</span><textarea name="excerpt" required maxlength="300" rows="2" placeholder="What will readers take away?"><%= post.excerpt || '' %></textarea></label><label>Story<textarea name="content" required minlength="20" maxlength="50000" rows="18" placeholder="Start with the thought you can't quite shake…"><%= post.content || '' %></textarea></label><label>Tags <span class="label-hint">Optional · separate with commas</span><input type="text" name="tagsText" maxlength="320" placeholder="craft, notes, ideas" value="<%= post.tags ? post.tags.join(', ') : '' %>"></label><label class="checkbox-label"><input type="checkbox" name="published" value="true" <%= post.published === false ? '' : 'checked' %>> Publish this story</label><div class="editor-actions"><button class="button button-dark" type="submit"><%= post._id ? 'Save changes' : 'Publish story' %> <span>↗</span></button><a class="button button-outline" href="/admin">Cancel</a></div></form></section>
<script src="/editor.js" defer></script>
<%- include('../partials/footer') %>
