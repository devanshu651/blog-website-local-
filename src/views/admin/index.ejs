<%- include('../partials/header', { title, description: 'Manage Inkwell stories.' }) %>
<section class="admin-page"><div class="admin-top"><div><div class="eyebrow"><span class="eyebrow-line"></span> YOUR WORKSPACE</div><h1>Stories, in progress.</h1><p>Make a new note, or revisit one already on the page.</p></div><a class="button button-dark" href="/admin/posts/new">Write a story <span>↗</span></a></div><div class="admin-list"><div class="admin-list-head"><span>STORY</span><span>STATUS</span><span>LAST UPDATED</span><span>ACTIONS</span></div><% if (posts.length) { posts.forEach((post) => { %><div class="admin-row"><div class="admin-story"><span class="admin-story-mark">✳</span><div><strong><%= post.title %></strong><small><%= post.author ? post.author.name : '' %> · <%= post.slug %></small></div></div><span class="status-pill <%= post.published ? 'status-live' : 'status-draft' %>"><%= post.published ? 'Published' : 'Draft' %></span><time><%= new Date(post.updatedAt).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' }) %></time><div class="admin-actions"><a href="/admin/posts/<%= post._id %>/edit">Edit</a><% if (post.published) { %><a href="/posts/<%= encodeURIComponent(post.slug) %>">View</a><% } %><form action="/admin/posts/<%= post._id %>/delete" method="post" onsubmit="return confirm('Delete this story? This cannot be undone.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="text-danger">Delete</button></form></div></div><% }) } else { %><div class="admin-empty"><p>No stories yet. Write the first one.</p><a href="/admin/posts/new">Start writing →</a></div><% } %></div></section>
<%- include('../partials/footer') %>
