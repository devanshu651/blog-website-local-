<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f5f0">
  <meta name="description" content="<%= description || 'Thoughtful notes on ideas, craft, and everyday discoveries.' %>">
  <link rel="canonical" href="<%= appUrl %><%= currentPath %>">
  <title><%= title %> · Inkwell</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Inkwell home"><span class="brand-mark">i.</span> inkwell</a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href="/">Stories</a>
      <% if (currentUser && currentUser.role === 'admin') { %><a href="/admin">Manage</a><% } %>
    </nav>
    <div class="nav-account">
      <% if (currentUser) { %>
        <span class="user-greeting">Hi, <%= currentUser.name.split(' ')[0] %></span>
        <form action="/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-quiet" type="submit">Sign out</button></form>
      <% } else { %><a class="button button-quiet" href="/login">Sign in</a><a class="button button-dark" href="/register">Join Inkwell <span aria-hidden="true">↗</span></a><% } %>
    </div>
  </header>
  <main class="page-shell">
