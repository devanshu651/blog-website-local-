<%- include('../partials/header', { title, description: 'Sign in to your Inkwell account.' }) %>
<section class="auth-wrap"><div class="auth-art"><span>✳</span><p>There’s always<br>room for a<br><em>good idea.</em></p><small>WELCOME BACK TO INKWELL</small></div><div class="auth-panel"><div class="eyebrow"><span class="eyebrow-line"></span> YOUR READING CORNER</div><h1>Welcome back.</h1><p class="auth-intro">Pick up where your curiosity left off.</p><% if (errors && errors.length) { %><div class="form-errors" role="alert"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %><form action="/login" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email address<input type="email" name="email" autocomplete="email" required maxlength="254" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="128"></label><button class="button button-dark button-wide" type="submit">Sign in <span>↗</span></button></form><p class="auth-switch">New around here? <a href="/register">Create an account</a></p></div></section>
<%- include('../partials/footer') %>
