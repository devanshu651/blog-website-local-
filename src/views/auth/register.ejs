<%- include('../partials/header', { title, description: 'Create your free Inkwell reader account.' }) %>
<section class="auth-wrap"><div class="auth-art auth-art-green"><span>✳</span><p>Come for a<br>minute. Stay<br>for an <em>idea.</em></p><small>A GOOD PLACE TO BEGIN</small></div><div class="auth-panel"><div class="eyebrow"><span class="eyebrow-line"></span> MAKE YOURSELF AT HOME</div><h1>Join Inkwell.</h1><p class="auth-intro">A little space for the things you like to read.</p><% if (errors && errors.length) { %><div class="form-errors" role="alert"><% errors.forEach((error) => { %><p><%= error %></p><% }) %></div><% } %><form action="/register" method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Your name<input type="text" name="name" autocomplete="name" required minlength="2" maxlength="80" value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>"></label><label>Email address<input type="email" name="email" autocomplete="email" required maxlength="254" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"></label><label>Password <span class="label-hint">12 characters or more</span><input type="password" name="password" autocomplete="new-password" required minlength="12" maxlength="128"></label><button class="button button-dark button-wide" type="submit">Create your account <span>↗</span></button></form><p class="auth-switch">Already a reader? <a href="/login">Sign in</a></p></div></section>
<%- include('../partials/footer') %>
